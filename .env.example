# ---------------------------------------------------------------------------
# OmniRelay 环境变量示例
#
# 复制为 .env（不要提交到仓库），只填写你实际使用的项。
# 所有真实 Token / AppSecret 只从环境变量读取，绝不写入仓库、日志或测试。
# ---------------------------------------------------------------------------

# ---- OneBot 11 反向 WebSocket 鉴权 ----------------------------------------
# 上层 OneBot 客户端连接 ws://127.0.0.1:8098/onebot/v11/ws 时必须携带：
#   Authorization: Bearer <ONEBOT_BRIDGE_TOKEN>
# 留空表示不鉴权（仅建议在本机回环地址下使用）。
ONEBOT_BRIDGE_TOKEN=change-me-to-a-long-random-string

# ---- Discord ---------------------------------------------------------------
# 在 Discord Developer Portal 创建 Bot 后获取。需要开启：
#   MESSAGE CONTENT INTENT、GUILD MESSAGES、DIRECT MESSAGES
DISCORD_BOT_TOKEN=

# ---- QQ 官方机器人 ---------------------------------------------------------
# 在 QQ 开放平台创建机器人后获取。AppSecret 等同于密码，切勿泄漏。
QQ_APP_ID=
QQ_APP_SECRET=

# ---- Web 控制台认证 -------------------------------------------------------
# 使用 `npm run hash-password -- "你的密码"` 生成，不要把明文密码放进环境变量。
WEB_ADMIN_PASSWORD_HASH=
# 会话签名密钥，使用 `openssl rand -base64 48` 或 `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"` 生成。
WEB_SESSION_SECRET=

# ---- 可选覆盖项 -----------------------------------------------------------
# OMNI_RELAY_CONFIG=./config.yaml
# OMNI_RELAY_ONEBOT_PORT=8098
# OMNI_RELAY_HEALTH_PORT=8080
# OMNI_RELAY_WEB_PORT=3000
# OMNI_RELAY_DATA_DIR=./data
# OMNI_RELAY_SQLITE_PATH=./data/bridge.sqlite
# OMNI_RELAY_LOG_LEVEL=info
# OMNI_RELAY_LOG_PRETTY=1
